---
permalink: /index.html
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>braindead.live &mdash; {{ calendar.next.title }}</title>
<meta name="description" content="{{ calendar.next.title }} &mdash; {{ calendar.next.start | day }}{% if calendar.next.location %}, {{ calendar.next.location }}{% endif %}">
<link rel="canonical" href="{{ site.url }}/">
<meta property="og:title" content="{{ calendar.next.title }}">
<meta property="og:description" content="{{ calendar.next.start | day }}{% if calendar.next.location %}, {{ calendar.next.location }}{% endif %}">
<meta property="og:image" content="{{ site.url }}{{ calendar.next.flyerUrl }}">
<meta property="og:url" content="{{ site.url }}/">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="{{ "/assets/icons/favicon.ico" | url }}" sizes="any">
<link rel="icon" type="image/png" sizes="32x32" href="{{ "/assets/icons/favicon-32.png" | url }}">
<link rel="icon" type="image/png" sizes="16x16" href="{{ "/assets/icons/favicon-16.png" | url }}">
<link rel="apple-touch-icon" href="{{ "/assets/icons/apple-touch-icon.png" | url }}">
<link rel="manifest" href="{{ "/site.webmanifest" | url }}">
<link rel="preload" href="{{ "/assets/fonts/shrikhand-400.woff2" | url }}" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ "/assets/css/site.css" | bust | url }}">
{% include "partials/analytics.njk" %}
</head>
<body class="landing">
<main class="lp">
  {#- Portrait first: it is the only source with its own framing, so it must
      win before the width-based tiers get a chance to match. Browsers pick
      the first <source> whose media query matches and do not re-evaluate on
      resize or rotation, which is fine here - the loaded clip keeps playing.
      The poster is a CSS background on .lp-video, not an attribute, so it
      can differ per orientation. -#}
  <video class="lp-video" autoplay muted loop playsinline
         aria-hidden="true" tabindex="-1">
    <source media="(orientation: portrait)" src="{{ "/assets/video/hero-portrait.mp4" | url }}" type="video/mp4">
    <source media="(min-width: 1400px)" src="{{ "/assets/video/hero-1080.mp4" | url }}" type="video/mp4">
    <source src="{{ "/assets/video/hero-720.mp4" | url }}" type="video/mp4">
  </video>
  <div class="lp-scrim" aria-hidden="true"></div>

  <div class="lp-content">
    <a class="lp-flyer" href="{{ calendar.next.url | url }}"
       data-umami-event="event-open" data-umami-event-placement="landing-flyer"
       data-umami-event-slug="{{ calendar.next.slug }}">
      {{ calendar.next.flyerHtml | safe }}
    </a>
    {% if calendar.next.ticketUrl %}
    <a class="lp-cta" href="{{ calendar.next.ticketUrl }}" rel="noopener"
       data-umami-event="buy-tickets"
       data-umami-event-placement="landing"
       data-umami-event-slug="{{ calendar.next.slug }}">Buy Tickets</a>
    {% endif %}
  </div>

  <a class="lp-continue" href="{{ "/home.html" | url }}" data-umami-event="landing-continue">continue &rarr;</a>

  <p class="lp-presented">
    presented by <a href="{{ site.instagram }}" target="_blank" rel="me noopener noreferrer"
      data-umami-event="social-instagram" data-umami-event-placement="credit">braindead live</a>&thinsp;<a
      class="lp-ig" href="{{ site.instagram }}" target="_blank" rel="me noopener noreferrer"
      data-umami-event="social-instagram" data-umami-event-placement="landing" aria-label="Brain Dead Live on Instagram"
      ><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.31-1.46.72-2.13 1.38C1.35 2.68.94 3.35.63 4.14.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.31.79.72 1.46 1.38 2.13.67.67 1.34 1.08 2.13 1.38.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56.79-.31 1.46-.72 2.13-1.38.67-.67 1.08-1.34 1.38-2.13.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91-.31-.79-.72-1.46-1.38-2.13C21.32 1.35 20.65.94 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0z"/><path d="M12 5.84A6.16 6.16 0 1 0 12 18.16 6.16 6.16 0 0 0 12 5.84zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8z"/><circle cx="18.41" cy="5.59" r="1.44"/></svg
    ></a>
  </p>
</main>
</body>
</html>
