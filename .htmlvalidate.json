{
  "extends": [
    "html-validate:recommended"
  ],
  "rules": {
    "void-style": "off",
    "no-trailing-whitespace": "off",
    "attr-quotes": [
      "error",
      {
        "style": "double",
        "unquoted": false
      }
    ],
    "wcag/h30": "error",
    "wcag/h37": "error",
    "wcag/h63": "error",
    "no-inline-style": "off",
    "prefer-native-element": "off",
    "no-autoplay": [
      "error",
      {
        "include": [
          "audio"
        ]
      }
    ],
    "long-title": [
      "error",
      {
        "maxlength": 170
      }
    ]
  },
  "elements": [
    "html5"
  ]
}
